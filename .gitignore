# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test
*-test
**/*-test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Code review artifacts
.code_review_results

# Built binaries (in project root)
/client*
/server*
/venture-client*
/venture-server*

# Test tool binaries
/terraintest*
/entitytest*
/itemtest*
/magictest*
/skilltest*
/genretest*
/genreblend*
/rendertest*
/tiletest*
/audiotest*
/movementtest*
/questtest*
/inventorytest*
/perftest*
/*demo*
/*test*
/dist
/run.sh
/perfprofile*
/complete_dungeon_generation
/terrain_entity_integration
*.backup
*.gz
/*.md
!README.md
!SECURITY.md
!PLAN.md
!AUDIT.md
!FEATURES_DISCOVERED.md
!ROADMAP.md
/*.log
/*.txt
.DS_Store
.idea/
.vscode/
/auditrunner
/featureaudit
/baseline.json
/refactored.json
**/refactored.json
**/baseline.json
/improvements.html

# Build directory - ignore everything except WASM static files
build/
!build/wasm/
!build/wasm/.gitignore
!build/wasm/README.md
!build/wasm/index.html
!build/wasm/game.html