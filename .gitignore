# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test
*-test
**/*-test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
*.coverage
*.tmp
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Code review artifacts
.code_review_results

# Built binaries (in project root)
/client*
/server*
/venture-client*
/venture-server*

# Test tool binaries
/terraintest*
/entitytest*
/itemtest*
/magictest*
/skilltest*
/genretest*
/genreblend*
/rendertest*
/tiletest*
/audiotest*
/movementtest*
/questtest*
/inventorytest*
/perftest*
/*demo*
/*test*
/dist
/run.sh
/validate_build.sh
/l.sh
/loop.sh
/cmd.sh
/perfprofile*
/complete_dungeon_generation
/terrain_entity_integration
/mod_repository_fs_integration
*.backup
*.gz
/*.md
!README.md
!SECURITY.md
!PLAN.md
!AUDIT.md
!PERFORMANCE_AUDIT.md
!FEATURES_DISCOVERED.md
!ROADMAP.md
!ANDROID_BUILD_REPORT.md
/*.log
/*.txt
.DS_Store
.idea/
.vscode/
/auditrunner
/featureaudit
/baseline.json
/refactored.json
**/refactored.json
**/baseline.json
/improvements.html

# Build directory - ignore everything except WASM static files and Android build config
build/
!build/wasm/
!build/wasm/.gitignore
!build/wasm/README.md
!build/wasm/index.html
!build/wasm/game.html
!build/android/
!build/android/AndroidManifest.xml
!build/android/build.gradle
!build/android/settings.gradle
!build/android/gradle.properties
!build/android/proguard-rules.pro
!build/android/gradlew
!build/android/gradlew.bat
!build/android/gradle/
!build/android/gradle/wrapper/
!build/android/gradle/wrapper/gradle-wrapper.jar
!build/android/gradle/wrapper/gradle-wrapper.properties
!build/android/src/
!build/android/src/main/
!build/android/src/main/java/
!build/android/src/main/java/com/
!build/android/src/main/java/com/venture/
!build/android/src/main/java/com/venture/game/
!build/android/src/main/java/**
!build/android/src/main/res/
!build/android/src/main/res/values/
!build/android/src/main/res/values/strings.xml
!build/android/res/
build/android/libs/
build/android/.gradle/
build/android/build/